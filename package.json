{
  "name": "openchamber-session-todos",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "See what your agents planned, what they are doing, and what they need from you, across every session and project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mradwankhalil/openchamber-session-todos.git"
  },
  "keywords": ["openchamber", "extension", "todo", "agents", "opencode"],
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "session-todos",
        "name": "Session Todos",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/index.html",
        "title": "Every session"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Todos",
        "height": 96
      },
      "capabilities": [
        "files",
        "sessions",
        "model"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "actions": [
        {
          "id": "add-to-todos",
          "label": "Add to my todos",
          "icon": "add-circle",
          "where": "message",
          "mode": "background"
        }
      ],
      "commands": [
        {
          "name": "todo",
          "description": "Add an item to your own todos for this session"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun run build:css && bun run build:status && bun run build:panel && bun run build:service",
    "build:css": "node scripts/copy-css.mjs",
    "build:status": "bunx openchamber-guest-bundle status/main.ts status/main.js",
    "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "typecheck": "bun x --bun -p typescript@5.6 tsc --noEmit -p .",
    "test": "bun test"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22"
  }
}
